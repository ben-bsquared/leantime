# Optional local shell template for docker compose. Copy values into your shell,
# Coolify environment, or another deployment manager before running compose.

# Docker image version to deploy. Pin this to a tagged Leantime release.
LEAN_VERSION=3.8.0

# Host port exposed by the Leantime container.
LEAN_PORT=8080

# MySQL container bootstrap configuration.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=leantime
MYSQL_USER=leantime
MYSQL_PASSWORD=change-me-db-password

# Required Leantime runtime configuration.
LEAN_DB_HOST=leantime-db
LEAN_DB_PORT=3306
LEAN_DB_DATABASE=leantime
LEAN_DB_USER=leantime
LEAN_DB_PASSWORD=change-me-db-password
LEAN_EMAIL_RETURN=changeme@example.com
LEAN_SESSION_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY
LEAN_LOG_CHANNELS=stderr

# Optional settings for reverse proxies and subfolder installs.
# LEAN_APP_URL=https://leantime.example.com
# LEAN_APP_DIR=/leantime
